# Gemini API key (read by the browser at build time, prefix must be VITE_).
# Get one free at https://aistudio.google.com/app/apikey
# Copy this file to `.env` and paste your key, then restart `npm run dev`.
VITE_GEMINI_API_KEY=AIza-your-key-here

# Optional: override the coaching model (defaults to gemini-2.5-flash-lite).
# VITE_COACH_MODEL=gemini-2.5-flash-lite

# Optional: Google Apps Script web app URL for the waitlist (must end in /exec).
# Without it, signups are accepted in the UI but not recorded anywhere.
# VITE_WAITLIST_URL=https://script.google.com/macros/s/YOUR-DEPLOYMENT-ID/exec
